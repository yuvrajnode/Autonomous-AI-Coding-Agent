# --- LLM -------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
ACA_MODEL=claude-sonnet-5-5
ACA_PLANNER_MODEL=claude-opus-5-5
ACA_MAX_TOKENS=16000
# low | medium | high | xhigh | max
ACA_EFFORT=medium

# --- Embeddings ------------------------------------------------------------
# provider: voyage | hashing   (hashing needs no key, used for local dev/CI)
ACA_EMBEDDING_PROVIDER=voyage
ACA_EMBEDDING_MODEL=voyage-3
ACA_EMBEDDING_DIM=1024
VOYAGE_API_KEY=pa-...

# --- Postgres / pgvector ---------------------------------------------------
# Host port docker compose publishes postgres on; keep it in step with the URL.
ACA_PG_PORT=5433
ACA_DATABASE_URL=postgresql://aca:aca@localhost:5433/aca

# --- Agent budgets ---------------------------------------------------------
ACA_MAX_ITERATIONS=24
ACA_MAX_REPLANS=3
ACA_STEP_TIMEOUT=120
ACA_USD_BUDGET=1.50

# --- Sandbox ---------------------------------------------------------------
ACA_WORKSPACE_ROOT=./workspaces
ACA_SHELL_TIMEOUT=60

# --- Observability ---------------------------------------------------------
ACA_TRACE_DIR=./traces
ACA_LOG_LEVEL=INFO
